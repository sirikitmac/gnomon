# ElevenLabs Text-to-Speech (used for Five's voice)
# Default voice: Peanut - Tiny & Peppy (rBkiq5ZQ43ogwd6i4uIQ)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_VOICE_ID=rBkiq5ZQ43ogwd6i4uIQ
VITE_ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Google Gemini API (Free Tier: gemini-3.8-flash or gemini-3.5-flash-lite)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional backend endpoint to proxy Five requests in production
# VITE_FIVE_API_URL=
